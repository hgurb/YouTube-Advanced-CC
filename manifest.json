{
  "manifest_version": 3,
  "name": "Youtube Advanced CC",
  "version": "1.2.0",
  "description": "CC: click to toggle, right-click to reset, scroll to resize. Right-click Settings for subtitles with English and Turkish first.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}